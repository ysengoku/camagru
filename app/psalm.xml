<?xml version="1.0"?>
<psalm
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="vendor/vimeo/psalm/config.xsd"
  errorBaseline="psalm-baseline.xml"
  phpVersion="8.5"
>
  <projectFiles>
    <directory name="src" />
    <directory name="cron" />
    <file name="public/index.php" />
    <ignoreFiles>
      <directory name="vendor" />
    </ignoreFiles>
  </projectFiles>

  <issueHandlers>
    <MissingParamType severity="error" />
    <MissingReturnType severity="error" />
    <!-- self-typed static property in a trait used by many classes; Psalm can't reconcile the type per using class -->
    <MismatchingDocblockPropertyType>
      <errorLevel type="suppress">
        <file name="src/core/SingletonTrait.php" />
      </errorLevel>
    </MismatchingDocblockPropertyType>
  </issueHandlers>
</psalm>
