{
  "name": "camagru/project",
  "description": "Camagru application",
  "type": "project",
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.7",
    "vimeo/psalm": "^6.16",
    "phpunit/phpunit": "^13.1"
  },
  "scripts": {
    "lint": "vendor/bin/phpcs --standard=phpcs.xml src",
    "fix": "vendor/bin/phpcbf --standard=phpcs.xml src",
    "psalm": "vendor/bin/psalm --use-baseline=psalm-baseline.xml"
  },
  "config": {
    "preferred-install": "dist"
  }
}
