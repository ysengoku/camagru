{
  "name": "camagru-app",
  "version": "1.0.0",
  "scripts": {
    "dev:ts": "CHOKIDAR_USEPOLLING=true tsx watch src/index.ts",
    "dev:css": "tailwindcss -i ./src/styles/main.css -o ./public/assets/css/output.css --watch",
    "dev": "concurrently \"npm run dev:css\" \"npm run dev:ts\"",
    "build": "tsc",
    "build:css": "tailwindcss -i ./public/assets/css/tailwind.css -o ./public/assets/css/output.css --minify",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^4.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
