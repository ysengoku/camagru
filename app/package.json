{
  "name": "camagru-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:ts": "CHOKIDAR_USEPOLLING=true tsx watch src/app.ts",
    "dev:css": "tailwindcss -i ./src/styles/main.css -o ./public/assets/css/output.css --watch",
    "dev": "concurrently \"npm run dev:css\" \"npm run dev:ts\"",
    "build": "tsc",
    "build:css": "tailwindcss -i ./public/assets/css/tailwind.css -o ./public/assets/css/output.css --minify",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts,.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.9.1",
    "@types/nodemailer": "^7.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
