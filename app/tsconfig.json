{
  "compilerOptions": {
    "target": "esnext",                       // Output JavaScript version
    "module": "ESNext",                       // Use ES module system
    "moduleResolution": "node",               // Resolve modules like Node.js
    "esModuleInterop": true,                  // Enable interoperability between CommonJS and ES Modules
    "forceConsistentCasingInFileNames": true, // Ensure consistent file name casing
    "strict": true,                           // Enable strict type checking
    "skipLibCheck": true,                     // Skip type checking of declaration files
    "types": ["node"],                        // Include Node.js type definitions
    "outDir": "dist"                          // Output directory for compiled files
  },
  "include": ["src"]                          // Files to include in compilation
}
