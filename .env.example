DB_HOST=camagru_database
DB_PORT=3306
MYSQL_DATABASE=camagru_database
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_USER=camagru_user
MYSQL_PASSWORD=your_password

# Use only in .env.dev for testing
# MYSQL_TEST_DATABASE=camagru_test

SMTP_HOST=your_smtp_server
SMTP_PORT=your_smpt_port
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM=your_email_address

APP_ASSETS_URL=https://yourdomain.example/path_to_assets

# Only required when deploying to a real domain
# DOMAIN_NAME=yourdomain.example

# Required manually once DOMAIN_NAME is set, since it is not auto-detected for deploys.
# Leave blank otherwise, it gets auto-detected.
HOST_IP=
